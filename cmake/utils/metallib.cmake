# Compile the hand-written Metal shaders into one .metallib and embed it as a C array (no file lookup at run time).
# Run with cmake -P and:
#   -DMETAL_BIN=<folder holding metal and metallib>  -DSOURCES=<a.metal;b.metal>  -DWORK_DIR=<scratch folder>
#   -DSYMBOL=<C array name>  -DOUTPUT=<generated header>

if(NOT EXISTS "${METAL_BIN}/metal" OR NOT EXISTS "${METAL_BIN}/metallib")
    message(FATAL_ERROR "Metal shader compiler not found in '${METAL_BIN}'.\n"
        "Mount the Metal Toolchain first:  source port/env.sh && omm_mount_metal")
endif()

file(MAKE_DIRECTORY ${WORK_DIR})

set(AIR_FILES)
foreach(SRC IN LISTS SOURCES)
    get_filename_component(NAME ${SRC} NAME_WE)
    set(AIR ${WORK_DIR}/${NAME}.air)
    execute_process(
        COMMAND ${METAL_BIN}/metal -std=metal4.0 -target air64-apple-macos26.0 -O3 -Wall -Werror
            -fmodules-cache-path=${WORK_DIR}/module-cache -c ${SRC} -o ${AIR}
        RESULT_VARIABLE RESULT)
    if(RESULT)
        message(FATAL_ERROR "metal failed on ${SRC}")
    endif()
    list(APPEND AIR_FILES ${AIR})
endforeach()

set(METALLIB ${WORK_DIR}/${SYMBOL}.metallib)
execute_process(COMMAND ${METAL_BIN}/metallib ${AIR_FILES} -o ${METALLIB} RESULT_VARIABLE RESULT)
if(RESULT)
    message(FATAL_ERROR "metallib failed")
endif()

execute_process(COMMAND xxd -i -n ${SYMBOL} ${METALLIB} OUTPUT_VARIABLE ARRAY RESULT_VARIABLE RESULT)
if(RESULT)
    message(FATAL_ERROR "xxd failed on ${METALLIB}")
endif()
string(REPLACE "unsigned char" "static const unsigned char" ARRAY "${ARRAY}")
string(REPLACE "unsigned int" "static const unsigned int" ARRAY "${ARRAY}")
file(WRITE ${OUTPUT} "// Generated by cmake/utils/metallib.cmake from the renderer_metal shaders. Do not edit.\n${ARRAY}")
